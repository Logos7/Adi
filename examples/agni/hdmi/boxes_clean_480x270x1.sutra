; 480x270 HDMI demo: clean double-buffered moving boxes.

.code
main:
    move r20, 0
    move r28, 0
    move r27, 0
    move r26, 0
    move r25, 0
    move r24, 0
    move r23, 0
    move r22, 0

    fbsize 480, 270

    move @hdmi.draw_bank, false
    fbclear r20
    move @hdmi.draw_bank, true
    fbclear r20

    move @hdmi.draw_bank, false
    move @hdmi.request_bank, false
    call wait_front_false

loop_bank_1:
    move @hdmi.draw_bank, true
    call draw_frame
    move @hdmi.request_bank, true
    call wait_front_true
    call tick_frame
    jump loop_bank_0

loop_bank_0:
    move @hdmi.draw_bank, false
    call draw_frame
    move @hdmi.request_bank, false
    call wait_front_false
    call tick_frame
    jump loop_bank_1

tick_frame:
    inc r28
    cmp.gt b0, r28, 359
    jump_if b0, tick_reset_fast

tick_after_fast:
    inc r24
    cmp.gt b0, r24, 1
    jump_if b0, tick_inc_half

tick_after_half:
    inc r23
    cmp.gt b0, r23, 2
    jump_if b0, tick_inc_third

tick_after_third:
    inc r22
    cmp.gt b0, r22, 3
    jump_if b0, tick_inc_quarter

tick_after_quarter:
    return

tick_reset_fast:
    move r28, 0
    jump tick_after_fast

tick_inc_half:
    move r24, 0
    inc r27
    cmp.gt b0, r27, 359
    jump_if b0, tick_reset_half
    jump tick_after_half

tick_reset_half:
    move r27, 0
    jump tick_after_half

tick_inc_third:
    move r23, 0
    inc r26
    cmp.gt b0, r26, 359
    jump_if b0, tick_reset_third
    jump tick_after_third

tick_reset_third:
    move r26, 0
    jump tick_after_third

tick_inc_quarter:
    move r22, 0
    inc r25
    cmp.gt b0, r25, 359
    jump_if b0, tick_reset_quarter
    jump tick_after_quarter

tick_reset_quarter:
    move r25, 0
    jump tick_after_quarter

draw_frame:
    fbclear r20

    move r10, r28
    move r11, 18
    move r12, 33
    move r13, 431
    move r14, 231
    move r3, 48
    move r4, 38
    call draw_box_param

    move r10, r27
    move r11, 127
    move r12, 91
    move r13, 407
    move r14, 217
    move r3, 72
    move r4, 52
    call draw_box_param

    move r10, r26
    move r11, 251
    move r12, 9
    move r13, 451
    move r14, 249
    move r3, 28
    move r4, 20
    call draw_box_param

    move r10, r25
    move r11, 77
    move r12, 171
    move r13, 383
    move r14, 199
    move r3, 96
    move r4, 70
    call draw_box_param

    move r10, r27
    move r11, 333
    move r12, 41
    move r13, 423
    move r14, 221
    move r3, 56
    move r4, 48
    call draw_box_param

    move r10, r28
    move r11, 405
    move r12, 207
    move r13, 455
    move r14, 257
    move r3, 24
    move r4, 12
    call draw_box_param

    return

draw_box_param:
    move r30, 0
    iadd r30, r30, r10
    iadd r30, r30, r11
    move r29, r13
    iadd r31, r13, r13
    call tri_coord
    move r1, r30

    move r30, 0
    iadd r30, r30, r10
    iadd r30, r30, r12
    move r29, r14
    iadd r31, r14, r14
    call tri_coord
    move r2, r30

    call draw_box_outline
    return

draw_box_outline:
    iadd r8, r1, r3
    iadd r9, r2, r4

    move r11, r1
    move r12, r2
    move r13, r8
    move r14, r9

    move r1, r11
    move r2, r12
    move r3, r13
    call draw_hline

    move r1, r11
    move r2, r14
    move r3, r13
    call draw_hline

    move r1, r11
    move r2, r12
    move r3, r14
    call draw_vline

    move r1, r13
    move r2, r12
    move r3, r14
    call draw_vline

    return

draw_hline:
    move r5, r1
hline_loop:
    fbplot r20, r5, r2
    inc r5
    cmp.lt b0, r5, r3
    jump_if b0, hline_loop
    fbplot r20, r3, r2
    return

draw_vline:
    move r5, r2
vline_loop:
    fbplot r20, r1, r5
    inc r5
    cmp.lt b0, r5, r3
    jump_if b0, vline_loop
    fbplot r20, r1, r3
    return

tri_coord:
tri_wrap:
    cmp.gt b0, r30, r31
    jump_if b0, tri_sub
    jump tri_fold
tri_sub:
    isub r30, r30, r31
    jump tri_wrap
tri_fold:
    cmp.gt b0, r30, r29
    jump_if b0, tri_mirror
    return
tri_mirror:
    isub r30, r31, r30
    return

wait_front_true:
    move b7, @hdmi.active_bank
    jump_if_not b7, wait_front_true
    return

wait_front_false:
    move b7, @hdmi.active_bank
    jump_if b7, wait_front_false
    return
